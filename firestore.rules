rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /ia_labs_enero_registros/{docId} {
      // Bloquea lectura, edición y borrado desde el cliente público
      allow read, update, delete: if false;

      // Solo permite crear si cumple con esquema, dominios y longitudes
      allow create: if
        request.resource.data.keys().hasAll([
          'fullName', 'email', 'department', 'challengeTitle',
          'backgroundProblem', 'category', 'participationType', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'fullName', 'email', 'department', 'challengeTitle',
          'backgroundProblem', 'category', 'participationType', 'teamMembers', 'createdAt'
        ]) &&

        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 5 &&
        request.resource.data.fullName.size() <= 100 &&

        request.resource.data.email is string &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.email.matches('^[a-zA-Z0-9._%+-]+@(vw\\.com\\.mx|proveed-vw\\.com\\.mx|outlook\\.com)$') &&

        request.resource.data.department is string &&
        request.resource.data.department.size() >= 2 &&
        request.resource.data.department.size() <= 100 &&

        request.resource.data.challengeTitle is string &&
        request.resource.data.challengeTitle.size() >= 10 &&
        request.resource.data.challengeTitle.size() <= 120 &&

        request.resource.data.backgroundProblem is string &&
        request.resource.data.backgroundProblem.size() >= 120 &&
        request.resource.data.backgroundProblem.size() <= 4500 &&

        request.resource.data.category is string &&
        request.resource.data.category.size() >= 3 &&
        request.resource.data.category.size() <= 80 &&

        request.resource.data.participationType in ['individual', 'equipo'] &&

        request.resource.data.createdAt == request.time;
    }

    // Cualquier otra ruta permanece bloqueada por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
